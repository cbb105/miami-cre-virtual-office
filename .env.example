# Copy this file to .env. Never commit .env or real API keys.
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STRONG_MODEL=gpt-4.1
DATABASE_PATH=data/office.sqlite
# Optional for private Codespaces; REQUIRED before exposing the app to other users.
OFFICE_ACCESS_TOKEN=
# Conservative reservation assumptions, not provider billing quotes.
LLM_BUDGET_USD_PER_MILLION_TOKENS=12
SEARCH_BUDGET_USD_PER_CALL=0.01
