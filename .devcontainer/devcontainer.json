{
  "name": "Miami CRE Virtual Office",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "22"}},
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Miami CRE Virtual Office", "onAutoForward": "openBrowser", "visibility": "private"}},
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/start.sh > /tmp/miami-office.log 2>&1 &",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
